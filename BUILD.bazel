load("@bazel_lib//lib:expand_template.bzl", "expand_template")
load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_load", "oci_push")
load(
    "@rules_rs//rs:rust_binary.bzl",
    "rust_binary",
)
load(
    "@rules_rs//rs:rust_library.bzl",
    "rust_library",
)
load(
    "@rules_rs//rs:rust_test.bzl",
    "rust_test",
)
load("@tar.bzl", "tar")
load(":integration_test.bzl", "rust_integration_test")

rust_library(
    name = "lib",
    srcs = [
        "src/forwarding.rs",
        "src/lib.rs",
        "src/server.rs",
    ],
    crate_name = "nbes",
    version = "0.0.0",  # TODO: stamp
    deps = [
        "//third_party/googleapis/google/devtools/build/v1:build_rust_proto",
        "@crates//:anyhow",
        "@crates//:futures",
        "@crates//:hyper-util",
        "@crates//:log",
        "@crates//:rand",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
        "@crates//:tower",
        "@crates//:url",
    ],
)

rust_test(
    name = "lib_test",
    size = "small",
    crate = ":lib",
)

expand_template(
    name = "rustc_env_file",
    out = "rustc_env_file.env",
    stamp_substitutions = {"0.0.0": "{{STABLE_NBES_VERSION}}"},
    template = [
        "CARGO_PKG_VERSION=0.0.0",
    ],
)

rust_binary(
    name = "bin",
    srcs = [
        "src/args.rs",
        "src/config_file.rs",
        "src/main.rs",
    ],
    binary_name = "nbes",
    rustc_env_files = [":rustc_env_file"],
    deps = [
        ":lib",
        "@crates//:anyhow",
        "@crates//:clap",
        "@crates//:env_logger",
        "@crates//:log",
        "@crates//:serde",
        "@crates//:serde_yaml_ng",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

rust_test(
    name = "bin_test",
    size = "small",
    crate = ":bin",
)

rust_integration_test(
    name = "async_test",
    src = "tests/async.rs",
    deps = [
        ":lib",
        "@crates//:anyhow",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
    ],
)

rust_integration_test(
    name = "blackhole_test",
    src = "tests/blackhole.rs",
    deps = [
        ":lib",
        "@crates//:anyhow",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

rust_integration_test(
    name = "forwarding_test",
    src = "tests/forwarding.rs",
    deps = [
        ":lib",
        "//third_party/googleapis/google/devtools/build/v1:build_rust_proto",
        "@crates//:anyhow",
        "@crates//:futures",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
    ],
)

rust_integration_test(
    name = "headers_test",
    src = "tests/headers.rs",
    deps = [
        ":lib",
        "@crates//:anyhow",
        "@crates//:futures",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

rust_integration_test(
    name = "tls_test",
    src = "tests/tls.rs",
    deps = [
        ":lib",
        "@crates//:anyhow",
        "@crates//:futures",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

rust_integration_test(
    name = "validation_test",
    src = "tests/validation.rs",
    deps = [
        ":lib",
        "//third_party/googleapis/google/devtools/build/v1:build_rust_proto",
        "@crates//:anyhow",
        "@crates//:futures",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

buildifier(
    name = "buildifier",
    exclude_patterns = [
        "./.git/*",
    ],
    lint_mode = "warn",
    mode = "fix",
)

buildifier(
    name = "buildifier.check",
    exclude_patterns = [
        "./.git/*",
    ],
    lint_mode = "warn",
    mode = "diff",
)

PLATFORMS = [
    "@llvm//platforms:linux_x86_64_gnu.2.28",
    "@llvm//platforms:linux_arm64_gnu.2.28",
    "@llvm//platforms:macos_amd64",
    "@llvm//platforms:macos_arm64",
]

[
    platform_transition_filegroup(
        name = "for_{}".format(p.split(":")[1]),
        srcs = [":bin"],
        tags = ["manual"],
        target_platform = p,
    )
    for p in PLATFORMS
]

filegroup(
    name = "multiplatform_bins",
    srcs = [":for_{}".format(p.split(":")[1]) for p in PLATFORMS],
    tags = ["manual"],
)

tar(
    name = "bin_layer",
    srcs = [":bin"],
    compress = "gzip",
)

write_file(
    name = "image_args",
    out = "image_args.txt",
    content = [
        "-c",
        "/config.yaml",
    ],
)

oci_image(
    name = "image",
    base = "@distroless_cc",
    cmd = ":image_args",
    entrypoint = ["/nbes"],
    tars = [":bin_layer"],
)

oci_load(
    name = "image.load",
    image = ":image",
    repo_tags = ["nbes:latest"],
)

oci_image_index(
    name = "image.multiarch",
    images = [":image"],
    platforms = [
        "@llvm//platforms:linux_x86_64_gnu.2.28",
        "@llvm//platforms:linux_arm64_gnu.2.28",
    ],
)

expand_template(
    name = "stamped_tags",
    out = "_stamped.tags.txt",
    stamp_substitutions = {"0.0.0": "{{STABLE_NBES_VERSION}}"},
    template = [
        "0.0.0",
        "latest",
    ],
)

oci_push(
    name = "image.push",
    image = ":image.multiarch",
    remote_tags = ":stamped_tags",
    repository = "ghcr.io/kormide/nbes",
)
