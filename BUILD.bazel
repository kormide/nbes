load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load(
    "@rules_rs//rs:rust_binary.bzl",
    "rust_binary",
)
load(
    "@rules_rs//rs:rust_library.bzl",
    "rust_library",
)
load(
    "@rules_rs//rs:rust_test.bzl",
    "rust_test",
)
load(":integration_test.bzl", "rust_integration_test")

rust_library(
    name = "lib",
    srcs = [
        "src/forwarding.rs",
        "src/lib.rs",
        "src/server.rs",
    ],
    crate_name = "nbes",
    version = "0.0.0",  # TODO: stamp
    deps = [
        "//third_party/googleapis/google/devtools/build/v1:build_rust_proto",
        "@crates//:anyhow",
        "@crates//:futures",
        "@crates//:hyper-util",
        "@crates//:log",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
        "@crates//:tower",
        "@crates//:url",
    ],
)

rust_test(
    name = "lib_test",
    size = "small",
    crate = ":lib",
)

rust_binary(
    name = "bin",
    srcs = [
        "src/args.rs",
        "src/main.rs",
    ],
    binary_name = "nbes",
    version = "0.0.0",  # TODO: stamp
    deps = [
        ":lib",
        "@crates//:anyhow",
        "@crates//:clap",
        "@crates//:env_logger",
        "@crates//:log",
        "@crates//:rand",
        "@crates//:tokio",
        "@crates//:url",
    ],
)

rust_test(
    name = "bin_test",
    size = "small",
    crate = ":bin",
)

rust_integration_test(
    name = "blackhole_test",
    src = "tests/blackhole.rs",
    deps = [
        ":lib",
        "@crates//:anyhow",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

rust_integration_test(
    name = "forwarding_test",
    src = "tests/forwarding.rs",
    deps = [
        ":lib",
        "//third_party/googleapis/google/devtools/build/v1:build_rust_proto",
        "@crates//:anyhow",
        "@crates//:futures",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
    ],
)

rust_integration_test(
    name = "headers_test",
    src = "tests/headers.rs",
    deps = [
        ":lib",
        "@crates//:anyhow",
        "@crates//:futures",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

rust_integration_test(
    name = "validation_test",
    src = "tests/validation.rs",
    deps = [
        ":lib",
        "//third_party/googleapis/google/devtools/build/v1:build_rust_proto",
        "@crates//:anyhow",
        "@crates//:futures",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

buildifier(
    name = "buildifier",
    exclude_patterns = [
        "./.git/*",
    ],
    lint_mode = "warn",
    mode = "fix",
)

buildifier(
    name = "buildifier.check",
    exclude_patterns = [
        "./.git/*",
    ],
    lint_mode = "warn",
    mode = "diff",
)
